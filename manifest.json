{
  "schemaVersion": 1,
  "id": "markdown.todo",
  "name": "To-do",
  "version": "1.1.1",
  "author": "Markdown To-do contributors",
  "description": "A small Markdown-backed priority list",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "TodoWidget.qml"
  },
  "barWidget": {
    "displayName": "To-do",
    "description": "P0, P1, and P2 tasks",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "file": "",
      "editor": ""
    },
    "schema": [
      {
        "key": "file",
        "type": "string",
        "label": "Markdown file (absolute path)"
      },
      {
        "key": "editor",
        "type": "string",
        "label": "Editor command (no shell)"
      }
    ]
  },
  "license": "MIT"
}
